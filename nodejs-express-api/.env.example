# Environment Variables Template
# Copy this file to .env for local development
# Do NOT commit .env with real credentials to version control

# ===========================================
# Application
# ===========================================
APP_NAME=Bits Tutor Connect
APP_URL=http://localhost:8060
APP_FRONTEND_URL=http://localhost:8050/
APP_SECRET=your-app-secret-here
APP_LANGUAGE=english
APP_PUBLIC_DIR=assets
NODE_ENV=development

# ===========================================
# Auth
# ===========================================
AUTH_USER_TOKEN_SECRET=your-jwt-secret-here
AUTH_API_TOKEN_SECRET=your-api-secret-here
AUTH_JWT_DURATION=2400
AUTH_OTP_DURATION=5

# ===========================================
# Database (MySQL)
# ===========================================
DB_NAME=btc
DB_TYPE=mysql
DB_HOST=localhost
DB_USERNAME=root
DB_PASSWORD=
DB_PORT=3306
DB_CHARSET=utf8
DB_RECORD_LIMIT=10
DB_ORDER_TYPE=DESC

# ===========================================
# Mail / SMTP
# ===========================================
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password
MAIL_SENDER_EMAIL=your-email@example.com
MAIL_SENDER_NAME=YourAppName
MAIL_HOST=mail.example.com
MAIL_SECURE=false
MAIL_PORT=587

# ===========================================
# Upload Settings
# ===========================================
UPLOAD_TEMP_DIR=uploads/temp/
UPLOAD_MAX_FILE_SIZE=5000

# ===========================================
# AWS S3 Configuration
# ===========================================
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_REGION=af-south-1
AWS_BUCKET=your-bucket-name
AWS_CLOUD_FRONT_URL=https://your-cloudfront-url.cloudfront.net
AWS_CLOUD_FRONT_KEY_PAIR_ID=your-cloudfront-key-pair-id
AWS_CLOUD_FRONT_PRIVATE_KEY_PATH=./cloudfront_private_key.pem
AWS_MEDIA_CONVERT_ENDPOINT=https://your-mediaconvert-endpoint

# ===========================================
# M-Pesa (Daraja API)
# ===========================================
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
MPESA_SHORTCODE=your-shortcode
MPESA_PASSKEY=your-passkey
MPESA_CALLBACK_URL=http://localhost:8060/api/components_data/callback
MPESA_ENV=sandbox

# ===========================================
# Google Auth (OAuth)
# ===========================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8060/auth/google/callback

# ===========================================
# Google Meet
# ===========================================
GOOGLE_MEET_CALENDAR_ID=your-calendar-id
GOOGLE_MEET_SERVICE_ACCOUNT=your-service-account@project.iam.gserviceaccount.com
GOOGLE_MEET_PROJECT_ID=your-project-id
GOOGLE_MEET_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----"

# ===========================================
# Pusher (Real-time)
# ===========================================
PUSHER_APP_ID=your-app-id
PUSHER_KEY=your-pusher-key
PUSHER_SECRET=your-pusher-secret
PUSHER_CLUSTER=ap2

# ===========================================
# CORS
# ===========================================
CORS_ORIGIN=http://localhost:8050