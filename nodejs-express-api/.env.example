# Server configuration
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=btc_db
DB_USER=btc_user
DB_PASSWORD=your_secure_db_password
DB_ROOT_PASSWORD=root_secure_password

# Set to false to disable automatic schema sync on app startup (use migrations instead)
DB_SYNC_ON_INIT=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=7d

# M-Pesa (Daraja API)
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_PASSKEY=your_mpesa_passkey
MPESA_SHORTCODE=your_shortcode
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback

# AWS S3 & CloudFront
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name
AWS_CLOUDFRONT_DISTRIBUTION_ID=your_cloudfront_distribution_id
AWS_CLOUDFRONT_KEY_PAIR_ID=your_key_pair_id
AWS_CLOUDFRONT_PRIVATE_KEY_PATH=./certs/private_key.pem

# Email (SMTP)
MAIL_HOST=mail.bitstutorconnect.co.ke
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=info@bitstutorconnect.co.ke
MAIL_PASSWORD=your_mail_password
MAIL_SENDER_EMAIL=info@bitstutorconnect.co.ke
MAIL_SENDER_NAME=bitstutorconnect
# Set to false to allow self-signed/mismatched certificates (development only)
# Must be true in production for security
MAIL_TLS_REJECT_UNAUTHORIZED=false

# Google Meet
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/google/callback

# File upload limits
MAX_FILE_SIZE=50000000
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,video/mp4,video/webm

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
